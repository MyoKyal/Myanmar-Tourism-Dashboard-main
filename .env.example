# MongoDB Atlas connection string for THIS project only.
# Use a dedicated Atlas database user and restrict it to the database below.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=myanmar_tourism_dashboard
MONGODB_COLLECTION_PREFIX=myanmar_tourism_

# Optional: local LLM for the Decision Center's "AI Insight" feature (src/lib/ollama.ts).
# Requires Ollama running locally (https://ollama.com) with the model pulled, e.g.:
#   ollama pull qwen2.5:1.5b
# If unset, these defaults are used. If Ollama isn't running, the feature is skipped
# silently -- the rest of the Decision Center works exactly the same either way.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
